# Copy to .env and fill in. Never commit the real .env.

# ---- Worker (puller) ----
# Where the hoko worker lives.
HOKO_API=https://hoko.zillessen.dev
# Bearer token used to call /api/hoko/list.
# Set with: npx wrangler secret put HOKO_PULLER_TOKEN
HOKO_PULLER_TOKEN=
# Polling cadence in seconds. 3600 = once per hour.
POLL_INTERVAL_SEC=3600

# ---- DTS client (SIDAP creds + endpoint) ----
# Service account issued by the canton (NOT your Hotelkontrolle web login).
SIDAP_USER=
SIDAP_PASS=
# Hotelkontrolle endpoint per the install email:
SIDAP_URL=https://sidap.hotelkontrolle.zh.ch/DtsApplService
