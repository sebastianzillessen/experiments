{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "baseUrl": ".",
    "paths": {
      // Die Edge Function importiert `jose` als URL (so lädt Deno sie beim
      // Deploy). Für Typecheck und Tests zeigt derselbe Import auf das
      // npm-Paket — siehe denselben Alias in vitest.config.ts.
      "https://esm.sh/jose@6.2.10": ["../node_modules/jose"]
    }
  },
  "include": ["src", "tests", "supabase/functions/family-calendar-sync/ics.ts", "supabase/functions/family-calendar-sync/crypto.ts", "supabase/functions/family-calendar-sync/url.ts"]
}
